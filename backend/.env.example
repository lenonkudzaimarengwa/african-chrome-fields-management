# Database Configuration
DATABASE_URL=postgresql://chrome_user:chrome_password@localhost:5432/african_chrome_db

# FastAPI Settings
API_TITLE=African Chrome Fields Management System
API_VERSION=1.0.0
DEBUG=True

# CORS Settings (Frontend domain)
FRONTEND_URL=http://localhost:5173

# JWT Secret (used for authentication tokens)
SECRET_KEY=your-super-secret-key-change-in-production

# Sync Configuration
SYNC_TIMEOUT=30
MAX_BATCH_SIZE=1000

# Logging
LOG_LEVEL=INFO
